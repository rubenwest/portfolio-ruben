---
import Page from '../layouts/Page.astro';
import PixelIcon from '../components/pixel-icons/PixelIcon.astro';
import { site } from '../content/site';
import { getLang, ui } from '../i18n';

const lang = getLang(Astro.currentLocale);
const copy = {
  es: {
    lead: 'Participo en la comunidad tecnológica de Almería. Me gusta compartir lo que aprendo y poner en contacto a quien empieza con quien lleva años en esto.',
    link: 'Conócela',
  },
  en: {
    lead: "I'm part of the tech community in Almería. I like sharing what I learn and connecting people who are just starting out with people who have been doing this for years.",
    link: 'Check it out',
  },
}[lang];
---
<Page title={ui[lang].nav.community}>
<section class="section section--alt" id="comunidad">
      <div class="container">
        <div class="community" data-reveal>
          <div class="community__icon">
            <PixelIcon name="globe" size={40} label={ui[lang].nav.community} />
          </div>
          <div>
            <p class="eyebrow">{ui[lang].nav.community}</p>
            <h1>Almería Tech</h1>
            <p class="lead">{copy.lead}</p>
            <a class="community__link" href={site.socials[2]?.href} target="_blank" rel="noopener noreferrer">
              {copy.link}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
</Page>
