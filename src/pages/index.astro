---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import ScrollTypewriter from '../components/hero/ScrollTypewriter.astro';
import NodeDiagram from '../components/diagrams/NodeDiagram.astro';
import TerminalMock from '../components/diagrams/mocks/TerminalMock.astro';
import ComponentTreeMock from '../components/diagrams/mocks/ComponentTreeMock.astro';
import TestReportMock from '../components/diagrams/mocks/TestReportMock.astro';
import TechMarquee from '../components/marquee/TechMarquee.astro';
import PixelIcon from '../components/pixel-icons/PixelIcon.astro';
import ExperienceCard from '../components/cards/ExperienceCard.astro';
import { experience } from '../content/experience';
import { stack, marqueeItems } from '../content/stack';
import { site } from '../content/site';
import type { DiagramNode } from '../components/diagrams/types';

const aiNodes: DiagramNode[] = [
  { icon: 'robot', label: 'Claude Code', x: 16, y: 22, to: { x: 34, y: 38 }, first: 'v' },
  { icon: 'terminal', label: 'Copilot', x: 84, y: 24, to: { x: 66, y: 38 }, first: 'v' },
  { icon: 'code', label: 'refactor', x: 12, y: 74, to: { x: 34, y: 62 }, first: 'v' },
  { icon: 'check', label: 'review', x: 86, y: 76, to: { x: 66, y: 62 }, first: 'v' },
];

const archNodes: DiagramNode[] = [
  { icon: 'tree', label: 'shell', x: 18, y: 28, to: { x: 36, y: 40 }, first: 'h' },
  { icon: 'briefcase', label: 'remotes', x: 82, y: 26, to: { x: 64, y: 40 }, first: 'h' },
  { icon: 'globe', label: 'design system', x: 20, y: 72, to: { x: 36, y: 60 }, first: 'h' },
  { icon: 'bolt', label: 'lazy load', x: 84, y: 74, to: { x: 64, y: 60 }, first: 'h' },
];

const qaNodes: DiagramNode[] = [
  { icon: 'check', label: 'unit', x: 15, y: 30, to: { x: 34, y: 42 }, first: 'v' },
  { icon: 'bolt', label: 'e2e', x: 85, y: 28, to: { x: 66, y: 42 }, first: 'v' },
  { icon: 'globe', label: 'a11y', x: 14, y: 72, to: { x: 34, y: 60 }, first: 'v' },
  { icon: 'terminal', label: 'CI/CD', x: 86, y: 74, to: { x: 66, y: 60 }, first: 'v' },
];
---

<Base>
  <Header />

  <main id="main">
    <Hero />

    <TechMarquee items={marqueeItems} />

    <ScrollTypewriter
      text="Escribo código *con* IA, no *a pesar* de ella."
      footnote="Claude Code y Copilot son parte de mi flujo diario: aceleran lo mecánico para que el criterio de arquitectura siga siendo mío."
    />

    <!-- ============ CÓMO TRABAJO ============ -->
    <section class="section" id="como-trabajo">
      <div class="container">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Cómo trabajo</p>
          <h2>Tres capas que definen cómo construyo producto hoy.</h2>
          <p class="lead">
            De la forma de escribir código al modo de sostenerlo en el tiempo.
            Cada bloque es una parte real de mi día a día, no una lista de buzzwords.
          </p>
        </header>

        <div class="capas">
          <article class="capa" data-reveal>
            <div class="capa__text">
              <span class="capa__num">01</span>
              <h3>Desarrollo asistido por IA</h3>
              <p>
                Uso agentes como copiloto de verdad: generan el andamiaje, yo
                dirijo la arquitectura y reviso cada decisión. Más velocidad en
                lo repetitivo, mismo listón de calidad.
              </p>
            </div>
            <NodeDiagram nodes={aiNodes}>
              <TerminalMock />
            </NodeDiagram>
          </article>

          <article class="capa capa--reverse" data-reveal>
            <div class="capa__text">
              <span class="capa__num">02</span>
              <h3>Arquitectura frontend</h3>
              <p>
                Microfrontends con Angular: un shell que orquesta, remotes
                independientes por equipo y un design system compartido. Escala
                sin que los equipos se pisen.
              </p>
            </div>
            <NodeDiagram nodes={archNodes}>
              <ComponentTreeMock />
            </NodeDiagram>
          </article>

          <article class="capa" data-reveal>
            <div class="capa__text">
              <span class="capa__num">03</span>
              <h3>Calidad de ingeniería</h3>
              <p>
                Testing en varias capas y CI que bloquea lo que no pasa. Vengo de
                sistemas bancarios donde un bug tenía consecuencias reales: esa
                mentalidad no se me ha ido.
              </p>
            </div>
            <NodeDiagram nodes={qaNodes}>
              <TestReportMock />
            </NodeDiagram>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ STACK ============ -->
    <section class="section section--alt" id="stack">
      <div class="container">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Stack</p>
          <h2>Con qué construyo.</h2>
        </header>

        <div class="stack-grid">
          {
            stack.map((category, index) => (
              <article class="stack-card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                <div class="stack-card__icon">
                  <PixelIcon name={category.icon} size={32} label={category.title} />
                </div>
                <h3>{category.title}</h3>
                <p class="stack-card__desc">{category.description}</p>
                <ul class="stack-card__items">
                  {category.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ EXPERIENCIA ============ -->
    <section class="section" id="experiencia">
      <div class="container">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Experiencia</p>
          <h2>De la banca crítica al liderazgo frontend.</h2>
          <p class="lead">
            Catorce años construyendo software. Los últimos, decidiendo cómo se
            construye.
          </p>
        </header>

        <div class="timeline">
          {
            experience.map((entry) => (
              <div data-reveal>
                <ExperienceCard entry={entry} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ COMUNIDAD ============ -->
    <section class="section section--alt" id="comunidad">
      <div class="container">
        <div class="community" data-reveal>
          <div class="community__icon">
            <PixelIcon name="globe" size={40} label="Comunidad" />
          </div>
          <div>
            <p class="eyebrow">Comunidad</p>
            <h2>Almería Tech</h2>
            <p class="lead">
              Participo en la comunidad tecnológica local: compartir lo aprendido
              y conectar a quien empieza con quien lleva años es parte de cómo
              entiendo esta profesión.
            </p>
            <a class="community__link" href={site.socials[2]?.href} target="_blank" rel="noopener noreferrer">
              Conócela
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="section cta">
      <div class="container cta__inner" data-reveal>
        <h2>¿Montamos algo que aguante?</h2>
        <p class="lead">
          Estoy abierto a proyectos de frontend, arquitectura y liderazgo técnico.
        </p>
        <a class="btn-cta" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .section--alt {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
  }

  .section__head {
    max-width: var(--max-width-prose);
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .section__head h2 {
    font-size: var(--fs-h2);
  }

  /* ---- capas "cómo trabajo" ---- */
  .capas {
    display: grid;
    gap: var(--space-3xl);
  }

  .capa {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .capa--reverse .capa__text {
    order: 2;
  }

  .capa__num {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .capa__text h3 {
    font-size: var(--fs-h3);
    margin-block: var(--space-sm) var(--space-md);
  }

  .capa__text p {
    color: var(--color-text-muted);
  }

  /* ---- stack ---- */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-lg);
  }

  .stack-card {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .stack-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
  }

  .stack-card__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    margin-bottom: var(--space-xs);
  }

  .stack-card h3 {
    font-size: 1.15rem;
  }

  .stack-card__desc {
    color: var(--color-text-dim);
    font-size: var(--fs-small);
  }

  .stack-card__items {
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .stack-card__items li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .stack-card__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-2);
  }

  /* ---- timeline ---- */
  .timeline {
    display: grid;
    gap: var(--space-lg);
  }

  /* ---- comunidad ---- */
  .community {
    display: flex;
    gap: var(--space-xl);
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .community__icon {
    flex: none;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .community h2 {
    font-size: var(--fs-h3);
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .community__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
    color: var(--color-accent-2);
    font-size: var(--fs-small);
  }

  .community__link span {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .community__link:hover span {
    transform: translateX(4px);
  }

  /* ---- cta final ---- */
  .cta__inner {
    text-align: center;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }

  .cta__inner h2 {
    font-size: var(--fs-h2);
  }

  .btn-cta {
    margin-top: var(--space-sm);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    background: linear-gradient(120deg, var(--color-accent), var(--color-accent-2));
    color: #fff;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  @media (max-width: 820px) {
    .capa {
      grid-template-columns: 1fr;
    }

    .capa--reverse .capa__text {
      order: 0;
    }

    .community {
      flex-direction: column;
    }
  }
</style>
