---
import Page from '../layouts/Page.astro';
import ScrollTypewriter from '../components/hero/ScrollTypewriter.astro';
import NodeDiagram from '../components/diagrams/NodeDiagram.astro';
import TerminalMock from '../components/diagrams/mocks/TerminalMock.astro';
import ComponentTreeMock from '../components/diagrams/mocks/ComponentTreeMock.astro';
import TestReportMock from '../components/diagrams/mocks/TestReportMock.astro';
import type { DiagramNode } from '../components/diagrams/types';
const aiNodes: DiagramNode[] = [
  { icon: 'robot', label: 'Claude Code', x: 16, y: 22, to: { x: 34, y: 38 }, first: 'v' },
  { icon: 'terminal', label: 'Copilot', x: 84, y: 24, to: { x: 66, y: 38 }, first: 'v' },
  { icon: 'code', label: 'refactor', x: 12, y: 74, to: { x: 34, y: 62 }, first: 'v' },
  { icon: 'check', label: 'review', x: 86, y: 76, to: { x: 66, y: 62 }, first: 'v' },
];

const archNodes: DiagramNode[] = [
  { icon: 'tree', label: 'shell', x: 18, y: 28, to: { x: 36, y: 40 }, first: 'h' },
  { icon: 'briefcase', label: 'remotes', x: 82, y: 26, to: { x: 64, y: 40 }, first: 'h' },
  { icon: 'globe', label: 'design system', x: 20, y: 72, to: { x: 36, y: 60 }, first: 'h' },
  { icon: 'bolt', label: 'lazy load', x: 84, y: 74, to: { x: 64, y: 60 }, first: 'h' },
];

const qaNodes: DiagramNode[] = [
  { icon: 'check', label: 'unit', x: 15, y: 30, to: { x: 34, y: 42 }, first: 'v' },
  { icon: 'bolt', label: 'e2e', x: 85, y: 28, to: { x: 66, y: 42 }, first: 'v' },
  { icon: 'globe', label: 'a11y', x: 14, y: 72, to: { x: 34, y: 60 }, first: 'v' },
  { icon: 'terminal', label: 'CI/CD', x: 86, y: 74, to: { x: 66, y: 60 }, first: 'v' },
];

---
<Page title="Cómo trabajo">
<section class="section" id="como-trabajo">
      <div class="container">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Cómo trabajo</p>
          <h1>Tres capas que definen cómo construyo producto hoy.</h1>
          <p class="lead">
            De la forma de escribir código al modo de sostenerlo en el tiempo.
            Cada bloque es una parte real de mi día a día, no una lista de buzzwords.
          </p>
        </header>

        <div class="capas">
          <article class="capa" data-reveal>
            <div class="capa__text">
              <span class="capa__num">01</span>
              <h3>Desarrollo asistido por IA</h3>
              <p>
                Uso agentes como copiloto de verdad: generan el andamiaje, yo
                dirijo la arquitectura y reviso cada decisión. Más velocidad en
                lo repetitivo, mismo listón de calidad.
              </p>
            </div>
            <NodeDiagram nodes={aiNodes}>
              <TerminalMock />
            </NodeDiagram>
          </article>

          <article class="capa capa--reverse" data-reveal>
            <div class="capa__text">
              <span class="capa__num">02</span>
              <h3>Arquitectura frontend</h3>
              <p>
                Microfrontends con Angular: un shell que orquesta, remotes
                independientes por equipo y un design system compartido. Escala
                sin que los equipos se pisen.
              </p>
            </div>
            <NodeDiagram nodes={archNodes}>
              <ComponentTreeMock />
            </NodeDiagram>
          </article>

          <article class="capa" data-reveal>
            <div class="capa__text">
              <span class="capa__num">03</span>
              <h3>Calidad de ingeniería</h3>
              <p>
                Testing en varias capas y CI que bloquea lo que no pasa. Vengo de
                sistemas bancarios donde un bug tenía consecuencias reales: esa
                mentalidad no se me ha ido.
              </p>
            </div>
            <NodeDiagram nodes={qaNodes}>
              <TestReportMock />
            </NodeDiagram>
          </article>
        </div>
      </div>
    </section>
<ScrollTypewriter text="Escribo código *con* IA, no *a pesar* de ella." footnote="Claude Code y Copilot son parte de mi flujo diario: aceleran lo mecánico para que el criterio de arquitectura siga siendo mío." scrollHeight="150vh" />
</Page>
