---
import Page from '../layouts/Page.astro';
import PixelIcon from '../components/pixel-icons/PixelIcon.astro';
import { site } from '../content/site';
---
<Page title="Comunidad">
<section class="section section--alt" id="comunidad">
      <div class="container">
        <div class="community" data-reveal>
          <div class="community__icon">
            <PixelIcon name="globe" size={40} label="Comunidad" />
          </div>
          <div>
            <p class="eyebrow">Comunidad</p>
            <h1>Almería Tech</h1>
            <p class="lead">
              Participo en la comunidad tecnológica local: compartir lo aprendido
              y conectar a quien empieza con quien lleva años es parte de cómo
              entiendo esta profesión.
            </p>
            <a class="community__link" href={site.socials[2]?.href} target="_blank" rel="noopener noreferrer">
              Conócela
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
</Page>
