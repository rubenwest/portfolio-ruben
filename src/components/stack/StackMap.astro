---
import PixelArt from '../pixel-icons/PixelArt.astro';
import { stack } from '../../content/stack';
import { getLang } from '../../i18n';
import { icons, layerY, palette, tools, WIRE_VIEW_WIDTH, wireFor, type LayerKey } from './stack-map-data';

const lang = getLang(Astro.currentLocale);

/** Mismo orden que `stack`: Frontend, Arquitectura, IA aplicada, Calidad. */
const layerKeys: LayerKey[] = ['frontend', 'architecture', 'ai', 'quality'];
const layers = layerKeys.map((key, index) => ({ key, title: stack[lang][index]!.title }));

const copy = {
  es: {
    eyebrow: 'Mapa del stack',
    title: 'Cómo encaja todo.',
    lead: 'Pasa el ratón por una capa para ver qué herramientas usa, o por una herramienta para ver en qué capa entra.',
  },
  en: {
    eyebrow: 'Stack map',
    title: 'How it all fits together.',
    lead: 'Hover a layer to see the tools behind it, or hover a tool to see which layer it belongs to.',
  },
}[lang];

/** Baldosas decorativas [columna, fila]; las de las herramientas se pintan aparte. */
const tiles: [number, number][] = [
  [0, 1], [2, 0], [3, 2], [5, 0], [8, 2], [9, 0], [10, 3], [11, 5],
  [1, 5], [3, 6], [6, 6], [9, 5], [0, 6], [11, 1], [6, 1], [4, 4], [7, 4],
];
const diamonds: [number, number][] = [[3.5, 1.5], [10.5, 5.5]];
---

<section class="stack-map-section" aria-labelledby="stack-map-title">
  <header class="section__head" data-reveal>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="stack-map-title">{copy.title}</h2>
    <p class="lead">{copy.lead}</p>
  </header>

  <div class="stack-map" data-stack-map>
    <div class="stack-map__tiles" aria-hidden="true">
      {tiles.map(([col, row]) => <span class="stack-map__tile" style={`--c:${col};--r:${row}`}></span>)}
      {diamonds.map(([col, row]) => <span class="stack-map__diamond" style={`--c:${col};--r:${row}`}></span>)}
    </div>

    <svg class="stack-map__wires" viewBox={`0 0 ${WIRE_VIEW_WIDTH} 100`} preserveAspectRatio="none" aria-hidden="true">
      {
        tools.map((tool, index) => {
          const wire = wireFor(tool);
          return (
            <g class="stack-map__wire" data-layer={tool.layer} data-tool={tool.name} style={`--delay:${index * 90}ms`}>
              <path d={wire.d} data-wire />
            </g>
          );
        })
      }
    </svg>

    <div class="stack-map__dots" aria-hidden="true">
      {
        tools.map((tool, index) => {
          const [x, y] = wireFor(tool).dot;
          return <span class="stack-map__dot" data-layer={tool.layer} data-tool={tool.name} style={`--x:${x}%;--y:${y}%;--delay:${index * 90 + 600}ms`}></span>;
        })
      }
    </div>

    <ul class="stack-map__tools">
      {
        tools.map((tool) => (
          <li class="stack-map__tool" style={`--x:${tool.x}%;--y:${tool.y}%`}>
            <button type="button" data-layer={tool.layer} data-tool={tool.name}>
              <PixelArt rows={icons[tool.icon]} palette={palette} size={40} />
              <span>{tool.name}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <ul class="stack-map__layers">
      {
        layers.map((layer) => (
          <li class="stack-map__layer" style={`--y:${layerY[layer.key]}%`}>
            <button type="button" data-layer={layer.key}>
              <span class="stack-map__layer-icon">
                <PixelArt rows={icons[layer.key]} palette={palette} size={32} />
              </span>
              <span class="stack-map__layer-title">{layer.title}</span>
            </button>
          </li>
        ))
      }
    </ul>

    {/* En pantallas estrechas: cada capa con sus herramientas debajo, sin cables. */}
    <ul class="stack-map__list">
      {
        layers.map((layer) => (
          <li>
            <p class="stack-map__list-title">
              <span class="stack-map__layer-icon">
                <PixelArt rows={icons[layer.key]} palette={palette} size={32} />
              </span>
              {layer.title}
            </p>
            <ul>
              {tools.filter((tool) => tool.layer === layer.key).map((tool) => (
                <li>
                  <PixelArt rows={icons[tool.icon]} palette={palette} size={32} />
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stack-map-section {
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .stack-map {
    --cols: 12;
    --rows: 7.5;
    --cell-w: calc(100% / var(--cols));
    --cell-h: calc(100% / var(--rows));
    --ink: #151515;
    --wire: #b9b4aa;
    --lit: #ff5100;
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    color: var(--ink);
    background-color: #f6f4ef;
    background-image:
      linear-gradient(to right, #e6e2d9 1px, transparent 1px),
      linear-gradient(to bottom, #e6e2d9 1px, transparent 1px);
    background-size: var(--cell-w) var(--cell-h);
  }

  .stack-map__tiles {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .stack-map__tile {
    position: absolute;
    left: calc(var(--c) * var(--cell-w));
    top: calc(var(--r) * var(--cell-h));
    width: var(--cell-w);
    height: var(--cell-h);
    background: #efece5;
  }

  .stack-map__diamond {
    position: absolute;
    left: calc(var(--c) * var(--cell-w));
    top: calc(var(--r) * var(--cell-h));
    width: 7%;
    aspect-ratio: 1;
    background: #ebe7df;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .stack-map__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: visible;
  }

  .stack-map__wire path {
    fill: none;
    stroke: var(--wire);
    /* Unidades del viewBox: ~1,5px con el panel a 1100px de ancho. */
    stroke-width: 0.22;
    stroke-linejoin: miter;
    transition:
      stroke-dashoffset 1.2s var(--ease-out) var(--delay),
      stroke 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .stack-map__dots {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .stack-map__dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 7px;
    height: 7px;
    background: var(--ink);
    transform: translate(-50%, -50%) rotate(45deg) scale(0);
    transition:
      transform 0.4s var(--ease-out) var(--delay),
      background 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .stack-map.is-drawn .stack-map__dot {
    transform: translate(-50%, -50%) rotate(45deg) scale(1);
  }

  .stack-map button {
    font: inherit;
    color: inherit;
    border: 0;
    cursor: default;
  }

  .stack-map button:focus-visible {
    outline: 2px solid var(--lit);
    outline-offset: 2px;
  }

  .stack-map__tools,
  .stack-map__layers {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-map__tool {
    position: absolute;
    z-index: 2;
    left: var(--x);
    top: var(--y);
    width: var(--cell-w);
    height: var(--cell-h);
    transform: translate(-50%, -50%);
  }

  .stack-map__tool button {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    background: #ebe7de;
    transition: background 0.25s var(--ease-out), opacity 0.25s var(--ease-out);
  }

  .stack-map__tool :global(.pixel-art) {
    transition: transform 0.3s var(--ease-out);
  }

  .stack-map__tool button span {
    font-family: var(--font-mono);
    font-size: clamp(8px, 0.75vw, 10px);
    letter-spacing: 0.04em;
    color: #6b675f;
    white-space: nowrap;
  }

  .stack-map__layer {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: var(--y);
    width: 30%;
    transform: translate(-50%, -50%);
  }

  .stack-map__layer button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1.25rem 0.45rem 0.45rem;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 1px 0 #e6e2d9, 0 10px 24px -18px #00000066;
    text-align: left;
    transition: box-shadow 0.25s var(--ease-out), opacity 0.25s var(--ease-out), translate 0.25s var(--ease-out);
  }

  .stack-map__layer-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    aspect-ratio: 1;
    background: #f2efe9;
  }

  .stack-map__layer-title {
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* ---- resaltado: una capa y sus herramientas ---- */
  .stack-map.has-focus .is-dim {
    opacity: 0.35;
  }

  .stack-map.has-focus .stack-map__wire.is-dim path {
    opacity: 0.35;
  }

  .stack-map__wire.is-lit path {
    stroke: var(--lit);
    stroke-width: 0.32;
  }

  .stack-map__dot.is-lit {
    background: var(--lit);
  }

  .stack-map__tool button.is-lit {
    background: #ffe3d3;
  }

  .stack-map__tool button.is-lit :global(.pixel-art) {
    transform: translateY(-3px);
  }

  .stack-map__layer button.is-lit {
    translate: 0 -2px;
    box-shadow: 0 0 0 2px var(--lit), 6px 8px 0 var(--ink);
  }

  .stack-map__list {
    display: none;
  }

  @media (max-width: 820px) {
    .stack-map {
      aspect-ratio: auto;
      padding: 1.25rem;
    }

    .stack-map__tiles,
    .stack-map__wires,
    .stack-map__dots,
    .stack-map__tools,
    .stack-map__layers {
      display: none;
    }

    .stack-map__list {
      display: grid;
      gap: 1rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .stack-map__list > li {
      padding: 0.75rem;
      border-radius: 6px;
      background: #ffffff;
      box-shadow: 0 1px 0 #e6e2d9;
    }

    .stack-map__list-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.1rem;
      font-weight: 500;
    }

    .stack-map__list ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
    }

    .stack-map__list ul li {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.6rem 0.35rem 0.35rem;
      background: #f2efe9;
      font-family: var(--font-mono);
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-map__wire path {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }

    .stack-map__dot {
      transform: translate(-50%, -50%) rotate(45deg) scale(1);
    }
  }
</style>

<script>
  let cleanup: (() => void) | undefined;

  function setup(): void {
    cleanup?.();
    const controller = new AbortController();
    const observers: IntersectionObserver[] = [];

    document.querySelectorAll<HTMLElement>('[data-stack-map]').forEach((map) => {
      // Los cables se dibujan al entrar en pantalla.
      const paths = Array.from(map.querySelectorAll<SVGPathElement>('[data-wire]'));
      paths.forEach((path) => {
        const length = path.getTotalLength();
        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = `${length}`;
      });

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          paths.forEach((path) => (path.style.strokeDashoffset = '0'));
          map.classList.add('is-drawn');
          observer.disconnect();
        },
        { threshold: 0.3 },
      );
      observer.observe(map);
      observers.push(observer);

      // Resaltado: capa → sus herramientas; herramienta → su capa y su cable.
      const parts = Array.from(map.querySelectorAll<HTMLElement | SVGElement>('[data-layer]'));
      let pinned: HTMLElement | null = null;

      const highlight = (source: HTMLElement | null) => {
        const layer = source?.dataset.layer;
        const tool = source?.dataset.tool;
        map.classList.toggle('has-focus', Boolean(source));
        parts.forEach((part) => {
          const sameLayer = part.dataset.layer === layer;
          // Desde una herramienta solo se encienden ella, su cable y su capa.
          const lit = source
            ? tool
              ? sameLayer && (part.dataset.tool === tool || !part.dataset.tool)
              : sameLayer
            : false;
          part.classList.toggle('is-lit', lit);
          part.classList.toggle('is-dim', Boolean(source) && !lit);
        });
      };

      map.querySelectorAll<HTMLButtonElement>('button[data-layer]').forEach((button) => {
        const { signal } = controller;
        button.addEventListener('pointerenter', () => { if (!pinned) highlight(button); }, { signal });
        button.addEventListener('pointerleave', () => { if (!pinned) highlight(null); }, { signal });
        button.addEventListener('focus', () => highlight(button), { signal });
        button.addEventListener('blur', () => { pinned = null; highlight(null); }, { signal });
        // En táctil no hay hover: un toque fija el resaltado y otro lo quita.
        button.addEventListener('click', () => {
          pinned = pinned === button ? null : button;
          highlight(pinned ?? null);
        }, { signal });
      });
    });

    cleanup = () => {
      controller.abort();
      observers.forEach((observer) => observer.disconnect());
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
