---
import { formatRange, type ExperienceEntry } from '../../content/experience';
import { getLang, ui } from '../../i18n';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
const isCurrent = entry.end === 'current';
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
---

<article class:list={['xp', { 'is-compact': !entry.highlight }]}>
  <details open={entry.highlight}>
    <summary class="xp__summary">
      <div class="xp__head">
        <div class="xp__role">
          <h3>{entry.role}</h3>
          <p class="xp__company">
            {entry.company}
            {isCurrent && <span class="xp__badge">{t.current}</span>}
          </p>
        </div>
        <div class="xp__meta">
          <time>{formatRange(entry.start, entry.end, lang)}</time>
          <span class="xp__location">{entry.location}</span>
        </div>
      </div>
      <p class="xp__lead">{entry.summary}</p>
      <span class="xp__toggle" aria-hidden="true">
        <span class="xp__toggle-label" data-open={t.showLess} data-closed={t.showMore}></span>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor">
          <path d="M4 6l4 4 4-4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </summary>

    <div class="xp__body">
      <ul class="xp__bullets">
        {entry.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <ul class="xp__tags">
        {entry.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </details>
</article>

<style>
  .xp {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .xp:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .xp.is-compact {
    background: var(--color-bg-soft);
  }

  details {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .xp__summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    gap: var(--space-sm);
  }

  .xp__summary::-webkit-details-marker {
    display: none;
  }

  .xp__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    justify-content: space-between;
    align-items: baseline;
  }

  .xp__role h3 {
    font-size: var(--fs-h3);
  }

  .xp__company {
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: 2px;
  }

  .xp__badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-3);
  }

  .xp__meta {
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--color-text-dim);
    display: grid;
    gap: 2px;
  }

  .xp__meta time {
    color: var(--color-text-muted);
  }

  .xp__lead {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .xp__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    width: fit-content;
  }

  .xp__toggle-label::after {
    content: attr(data-closed);
  }

  details[open] .xp__toggle-label::after {
    content: attr(data-open);
  }

  details[open] .xp__toggle svg {
    transform: rotate(180deg);
  }

  .xp__toggle svg {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .xp__body {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-lg);
  }

  .xp__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-sm);
  }

  .xp__bullets li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text);
    font-size: var(--fs-small);
  }

  .xp__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .xp__tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .xp__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .xp__meta {
      text-align: left;
    }
  }
</style>
