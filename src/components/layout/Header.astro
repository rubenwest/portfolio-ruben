---
import PixelFlag from '../pixel-icons/PixelFlag.astro';
import { site } from '../../content/site';
import { getLang, languages, localizedPath, navigation, routes, ui, type Lang } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const langs = Object.keys(languages) as Lang[];
---

<header class="header" transition:name="site-header">
  <div class="container header__inner">
    <a class="header__brand" href={routes.home[lang]}>
      <span class="header__mark" aria-hidden="true"></span>
      {site.name}
    </a>

    <nav class="header__nav" aria-label={t.mainNav}>
      {navigation(lang).map((item) => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <nav class="header__lang" aria-label={t.langNav}>
      {
        langs.map((code) => (
          <a
            href={localizedPath(pathname, code)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'true' : undefined}
            title={languages[code]}
          >
            <PixelFlag lang={code} />
            <span class="visually-hidden">{languages[code]}</span>
          </a>
        ))
      }
    </nav>

    <a class="header__cta" href={`${routes.home[lang]}#contacto`}>{t.cta}</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    height: 64px;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .header__mark {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    box-shadow: 0 0 12px -2px var(--color-accent);
  }

  .header__nav {
    display: flex;
    gap: var(--space-lg);
    margin-left: auto;
    font-size: var(--fs-small);
  }

  .header__nav a {
    color: var(--color-text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__nav a:hover {
    color: var(--color-text);
  }

  .header__lang {
    display: flex;
    align-self: stretch;
    border-left: 1px solid var(--color-border);
  }

  .header__lang a {
    display: grid;
    place-items: center;
    padding: 0 0.7rem;
    opacity: 0.55;
    filter: saturate(0.5);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      filter var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .header__lang a:hover {
    opacity: 1;
    filter: none;
  }

  .header__lang a:hover :global(.pixel-flag) {
    transform: translateY(-2px);
  }

  .header__lang :global(.pixel-flag) {
    transition: transform var(--dur-fast) var(--ease-out);
    box-shadow: 2px 2px 0 #00000066;
  }

  .header__lang a[aria-current] {
    opacity: 1;
    filter: none;
    box-shadow: inset 0 -2px var(--color-accent);
  }

  .header__cta {
    padding: 8px 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .header__cta:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  @media (max-width: 720px) {
    .header__inner {
      height: auto;
      min-height: 64px;
      gap: 0;
    }

    .header__nav {
      display: none;
    }

    .header__lang {
      height: 64px;
      margin-left: 0.5rem;
    }

    .header__lang a {
      padding: 0 0.4rem;
    }

    .header__lang :global(.pixel-flag) {
      width: 24px;
      height: auto;
    }

    .header .header__cta {
      margin-left: 0;
      padding: 0 0.8rem;
      white-space: nowrap;
    }
  }
</style>
