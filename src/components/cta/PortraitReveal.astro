---
import { Image } from 'astro:assets';
import portrait from '../../assets/ruben-sofa.png';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<figure class="portrait" data-portrait>
  <Image
    class="portrait__img"
    src={portrait}
    alt={alt}
    widths={[640, 1000, 1400, 2000]}
    sizes="(max-width: 820px) 100vw, 58vw"
    format="webp"
    quality={80}
    loading="lazy"
    data-portrait-img
  />
  <canvas class="portrait__pixels" aria-hidden="true" data-portrait-canvas></canvas>
</figure>

<style>
  .portrait {
    position: relative;
    margin: 0;
    width: 100%;
  }

  .portrait__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait__pixels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    pointer-events: none;
  }

  /* Sin JS o con movimiento reducido se queda la foto nítida. */
  .portrait.is-enhanced .portrait__img {
    opacity: 0;
  }

  .portrait.is-enhanced .portrait__pixels {
    opacity: 1;
  }

  .portrait.is-enhanced.is-resolved .portrait__img {
    opacity: 1;
  }

  .portrait.is-enhanced.is-resolved .portrait__pixels {
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
</style>

<script>
  /**
   * La foto entra pixelada con la paleta del bloque y se va resolviendo con el
   * scroll: el tamaño de píxel baja de MAX_BLOCK a 1 mientras el color pasa de
   * la paleta a la foto real.
   */
  const MAX_BLOCK = 44;
  const PALETTE: [number, number, number][] = [
    [21, 21, 21],
    [84, 32, 0],
    [189, 54, 0],
    [255, 192, 67],
    [255, 244, 230],
  ];

  let cleanup: (() => void) | undefined;

  function setup(): void {
    cleanup?.();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const controller = new AbortController();
    const frames: number[] = [];

    document.querySelectorAll<HTMLElement>('[data-portrait]').forEach((figure) => {
      const img = figure.querySelector<HTMLImageElement>('[data-portrait-img]')!;
      const canvas = figure.querySelector<HTMLCanvasElement>('[data-portrait-canvas]')!;
      const ctx = canvas.getContext('2d');
      const small = document.createElement('canvas');
      const smallCtx = small.getContext('2d', { willReadFrequently: true });
      if (!ctx || !smallCtx) return;

      let lastBlock = 0;
      let ready = false;

      const draw = (block: number) => {
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (!width || !height) return;

        const cols = Math.max(1, Math.ceil(width / block));
        const rows = Math.max(1, Math.ceil(height / block));
        small.width = cols;
        small.height = rows;
        smallCtx.clearRect(0, 0, cols, rows);
        smallCtx.drawImage(img, 0, 0, cols, rows);

        // Cuanto más grande el píxel, más pesa la paleta sobre el color real.
        const tint = Math.min(1, Math.max(0, (block - 3) / 24));
        const pixels = smallCtx.getImageData(0, 0, cols, rows);
        const data = pixels.data;
        for (let i = 0; i < data.length; i += 4) {
          const alpha = data[i + 3]!;
          if (alpha < 110) {
            data[i + 3] = 0;
            continue;
          }
          data[i + 3] = 255;
          const r = data[i]!;
          const g = data[i + 1]!;
          const b = data[i + 2]!;
          const luma = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          const tone = PALETTE[Math.min(PALETTE.length - 1, Math.floor(luma * PALETTE.length))]!;
          data[i] = r + (tone[0] - r) * tint;
          data[i + 1] = g + (tone[1] - g) * tint;
          data[i + 2] = b + (tone[2] - b) * tint;
        }
        smallCtx.putImageData(pixels, 0, 0);

        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        ctx.imageSmoothingEnabled = false;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(small, 0, 0, cols * block * ratio, rows * block * ratio);
      };

      const update = () => {
        if (!ready) return;
        const rect = figure.getBoundingClientRect();
        const viewport = window.innerHeight;
        // 0 cuando asoma por abajo, 1 cuando su borde superior llega a media pantalla.
        const progress = Math.min(1, Math.max(0, (viewport - rect.top) / (viewport * 0.5)));
        const eased = 1 - Math.pow(1 - progress, 2);
        const block = Math.max(1, Math.round(MAX_BLOCK * (1 - eased)));

        figure.classList.toggle('is-resolved', block <= 3);
        if (block <= 3 || block === lastBlock) return;
        lastBlock = block;
        draw(block);
      };

      const schedule = () => {
        frames.push(requestAnimationFrame(update));
      };

      const start = () => {
        ready = true;
        figure.classList.add('is-enhanced');
        lastBlock = 0;
        update();
      };

      // El <img> es lazy: se fuerza la carga para poder pixelarlo antes de verlo.
      img.loading = 'eager';
      if (img.complete && img.naturalWidth) start();
      else img.addEventListener('load', start, { once: true, signal: controller.signal });

      window.addEventListener('scroll', schedule, { passive: true, signal: controller.signal });
      window.addEventListener('resize', () => { lastBlock = 0; schedule(); }, { signal: controller.signal });
    });

    cleanup = () => {
      controller.abort();
      frames.forEach(cancelAnimationFrame);
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
