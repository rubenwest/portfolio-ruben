---
import PixelGarden from './PixelGarden.astro';
import PixelIcon from '../pixel-icons/PixelIcon.astro';
import { site } from '../../content/site';
import { getLang, routes } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const copy = {
  es: {
    title: ['Frontend.', 'Con criterio.'],
    statement: 'Ingeniería sólida.',
    statementTail: 'Ideas en movimiento.',
    intro: 'Construyo productos que tienen que aguantar producción.',
    detail: 'Angular, microfrontends y agentes de IA. De la arquitectura al último detalle.',
    workLink: 'Así trabajo',
    from: 'Desde',
    experienceLink: 'Explora mi experiencia',
  },
  en: {
    title: ['Frontend.', 'With judgement.'],
    statement: 'Solid engineering.',
    statementTail: 'Ideas in motion.',
    intro: 'I build products that have to hold up in production.',
    detail: 'Angular, microfrontends and AI agents. From architecture down to the last detail.',
    workLink: 'How I work',
    from: 'Based in',
    experienceLink: 'See my experience',
  },
}[lang];
const { statement, statementTail } = copy;
const badges = ['angular', 'react', 'vue'] as const;
---
<section class="hero-scene" id="top" data-hero-scene>
  <div class="hero">
    <div class="hero__heading" data-hero-fade>
      <p class="eyebrow">{site.name} / {site.role}</p>
      <h1>{copy.title[0]}<br />{copy.title[1]}</h1>
    </div>
    <div class="hero__intro" data-hero-fade>
      <p>{copy.intro}</p>
      <span>{copy.detail}</span>
      <a href={routes.work[lang]}>{copy.workLink} <span aria-hidden="true">↘</span></a>
    </div>
    <div class="hero__garden"><PixelGarden /></div>
    <aside class="hero__aside">
      <span class="hero__arrows" aria-hidden="true" data-hero-fade>↓<br />↓<br />↓</span>
      <div>
        <p class="eyebrow" data-hero-fade>{copy.from} {site.location[lang]}</p>
        {/* Copia en flujo: reserva el hueco del aside y es la que leen los
            lectores de pantalla. La que se ve la dibuja .hero__focus encima. */}
        <p class="hero__slot" data-hero-slot>{statement}<br />{statementTail}</p>
      </div>
      <a href={routes.experience[lang]} data-hero-fade>{copy.experienceLink} <span aria-hidden="true">↗</span></a>
    </aside>

    {/* Se dibuja al tamaño final y encoge hasta el hueco del aside: así el
        estado grande cae en scale(1) y el texto no se ve difuso. */}
    <div class="hero__focus" aria-hidden="true">
      <div class="hero__badges">
        {badges.map((name) => <PixelIcon name={name} size={28} />)}
      </div>
      <p class="hero__statement" data-hero-statement>{statement}<br />{statementTail}</p>
    </div>
  </div>
</section>
<style>
  /* El hero se queda fijo mientras la escena recorre su altura: el mosaico
     colapsa hacia la izquierda y la frase del aside crece hasta el centro. */
  .hero-scene {position:relative;height:220vh}
  .hero {position:sticky;top:0;min-height:100vh;min-height:100svh;display:grid;grid-template-columns:7fr 3fr;grid-template-rows:auto 1fr;overflow:hidden;scroll-margin-top:64px}
  .hero__heading {position:relative;z-index:1;padding:clamp(2rem,5vw,5rem) var(--gutter) 3rem;min-height:400px;display:flex;flex-direction:column;justify-content:space-between}
  h1 {font-family:var(--font-body);font-size:clamp(4rem,8.6vw,8.5rem);font-weight:450;letter-spacing:-.075em;line-height:.98;margin-top:3rem}
  .hero__intro {position:relative;z-index:2;background:var(--color-bg-soft);border-left:1px solid var(--color-border);padding:2.5rem;display:flex;flex-direction:column;justify-content:flex-end;gap:1.5rem}
  .hero__intro>p {font-size:clamp(1.35rem,2vw,1.9rem);line-height:1.2;letter-spacing:-.04em}
  .hero__intro>span {font-size:.9rem;color:var(--color-text-muted)}
  .hero__intro a,.hero__aside>a {display:flex;justify-content:space-between;font-size:.85rem;border-top:1px solid var(--color-border);padding-top:1rem}
  a span {transition:transform .25s}a:hover span {transform:translate(3px,3px)}
  .hero__aside {position:relative;z-index:3;padding:2rem 2.5rem;display:flex;flex-direction:column;justify-content:space-between;gap:2rem;border-left:1px solid rgba(255,255,255,calc(.09 * (1 - var(--pf,0))))}
  .hero__arrows {line-height:1.3;color:var(--color-text-dim)}
  .hero__slot {font-size:1.3rem;line-height:1.3;margin-top:1rem;opacity:0}

  /* Mosaico: se recorta por la derecha (las columnas desaparecen en lugar de
     comprimirse) y encoge hacia su borde izquierdo. */
  .hero__garden {position:relative;z-index:0;transform-origin:0 50%;transform:translateY(calc(-7vh * var(--pg,0))) scale(calc(1 - .46 * var(--pg,0)));clip-path:inset(0 calc(100% * var(--pg,0)) 0 0);will-change:transform,clip-path}

  /* Bloque final: posición y tamaño naturales. El script calcula el salto
     hasta el hueco del aside, que es donde arranca. */
  /* Centrado por flex, sin translate: así offsetLeft/offsetTop siguen dando la
     posición real y las medidas no dependen de ninguna transformación. */
  .hero__focus {position:absolute;z-index:5;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem;pointer-events:none}
  .hero__badges {display:flex;gap:1rem;opacity:calc((var(--pt,0) - .7) / .3);transform:translateY(calc(10px * (1 - var(--pt,0))))}
  .hero__badges :global([data-icon='angular']) {--pixel-1:#dd0031;--pixel-2:#fff}
  .hero__badges :global([data-icon='react']) {--pixel-1:#61dafb;--pixel-2:#61dafb}
  .hero__badges :global([data-icon='vue']) {--pixel-1:#42b883;--pixel-2:#9fdfbf}

  /* Escala de --k (el tamaño del aside) a 1: termina en su rasterizado nativo,
     sin el difuminado que deja ampliar un texto ya pintado. */
  .hero__statement {margin:0;font-size:clamp(1.9rem,3.9vw,3.5rem);line-height:1.15;letter-spacing:-.035em;transform-origin:50% 50%;transform:translate(calc(var(--dx,0px) * (1 - var(--pt,0))),calc(var(--dy,0px) * (1 - var(--pt,0)))) scale(calc(var(--k,.38) + (1 - var(--k,.38)) * var(--pt,0)))}

  [data-hero-fade] {opacity:calc(1 - var(--pf,0))}

  @media(max-width:720px){
    /* Sin aside no hay frase que mover: la escena se desactiva. */
    .hero-scene{height:auto}
    .hero{position:static;min-height:0;grid-template-columns:1fr;grid-template-rows:none;overflow:visible}
    .hero__heading{min-height:340px}
    .hero__intro{border-left:0;padding:2rem var(--gutter)}
    .hero__aside{display:none}
    h1{font-size:clamp(3.8rem,13vw,6rem)}
    .hero__garden{transform:none;clip-path:none}
    .hero__focus{display:none}
  }

  @media(prefers-reduced-motion:reduce){
    .hero-scene{height:auto}
    .hero{position:static;min-height:0;overflow:visible}
    .hero__garden{transform:none;clip-path:none}
    .hero__focus{display:none}
    .hero__slot{opacity:1}
    [data-hero-fade]{opacity:1}
  }
</style>

<script>
  let teardown: (() => void) | null = null;

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  /** smoothstep: entra y sale sin tirones. */
  const smooth = (t: number) => t * t * (3 - 2 * t);

  function setup(): void {
    teardown?.();

    const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
    const hero = scene?.firstElementChild as HTMLElement | null;
    const statement = scene?.querySelector<HTMLElement>('[data-hero-statement]');
    const slot = scene?.querySelector<HTMLElement>('[data-hero-slot]');
    if (!scene || !hero || !statement || !slot) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let enabled = false;
    let frame = 0;

    /** Posición de maquetación dentro del hero, inmune a los transforms. */
    function offsetIn(el: HTMLElement, root: HTMLElement): [number, number] {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;

      while (node && node !== root) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }

      return [x, y];
    }

    /**
     * Calcula el salto desde la posición natural de la frase (grande, centrada)
     * hasta el hueco que ocupa en el aside, y la escala que la iguala a él.
     */
    function measure(): void {
      enabled = window.innerWidth > 720;
      if (!enabled) return;

      const slotSize = parseFloat(getComputedStyle(slot!).fontSize) || 21;
      const size = parseFloat(getComputedStyle(statement!).fontSize) || 56;
      const k = slotSize / size;

      const [sx, sy] = offsetIn(statement!, hero!);
      const [qx, qy] = offsetIn(slot!, hero!);

      // El texto del aside está alineado a la izquierda: su centro cae a media
      // anchura ya escalada desde el borde del hueco.
      const slotCx = qx + (statement!.offsetWidth * k) / 2;
      const slotCy = qy + slot!.offsetHeight / 2;

      scene!.style.setProperty('--k', String(k));
      scene!.style.setProperty(
        '--dx',
        `${slotCx - (sx + statement!.offsetWidth / 2)}px`,
      );
      scene!.style.setProperty(
        '--dy',
        `${slotCy - (sy + statement!.offsetHeight / 2)}px`,
      );
    }

    function update(): void {
      frame = 0;
      if (!enabled) return;

      // El recorrido se recalcula aquí: al medirlo una sola vez quedaba a cero
      // si el layout aún no estaba resuelto (estilos o fuentes por llegar).
      const rect = scene!.getBoundingClientRect();
      const travel = rect.height - hero!.offsetHeight;
      if (travel <= 0) return;

      const progress = clamp01(-rect.top / travel);

      // El texto secundario se apaga pronto; el mosaico colapsa durante casi
      // todo el recorrido y la frase termina antes del final, para dejar aire.
      scene!.style.setProperty('--pf', String(smooth(clamp01(progress / 0.3))));
      scene!.style.setProperty('--pg', String(smooth(clamp01(progress / 0.85))));
      scene!.style.setProperty(
        '--pt',
        String(smooth(clamp01((progress - 0.05) / 0.65))),
      );
    }

    function schedule(): void {
      if (!frame) frame = requestAnimationFrame(update);
    }

    function onResize(): void {
      measure();
      schedule();
    }

    measure();
    update();

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });

    // Remide cuando el layout cambie de verdad (estilos o fuentes que llegan
    // tarde), en vez de confiar en que la primera medición pille todo hecho.
    const observer = new ResizeObserver(onResize);
    observer.observe(hero);
    observer.observe(slot);

    teardown = () => {
      observer.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', onResize);
      cancelAnimationFrame(frame);
      teardown = null;
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => teardown?.());
</script>
