---
interface Line {
  kind: 'prompt' | 'step' | 'done';
  text: string;
}

const lines: Line[] = [
  { kind: 'prompt', text: 'claude "migra este formulario a signals"' },
  { kind: 'step', text: 'Leyendo solicitud.component.ts' },
  { kind: 'step', text: '3 @Input() y 2 @Output() detectados' },
  { kind: 'done', text: 'Refactor aplicado · 118 líneas' },
  { kind: 'done', text: 'Tests: 14 passed, 0 failed' },
];
---

<div class="terminal" data-sequence style="--step: 400ms">
  <header class="terminal__bar">
    <span></span><span></span><span></span>
    <p>claude-code</p>
  </header>

  <ol class="terminal__body">
    {
      lines.map((line, index) => (
        <li class:list={['terminal__line', `is-${line.kind}`]} data-step style={`--i: ${index}`}>
          <span class="terminal__sigil" aria-hidden="true">
            {line.kind === 'prompt' ? '$' : line.kind === 'step' ? '●' : '✔'}
          </span>
          <span>{line.text}</span>
        </li>
      ))
    }
    <li class="terminal__line is-cursor" data-step style={`--i: ${lines.length}`}>
      <span class="terminal__sigil" aria-hidden="true">$</span>
      <span class="terminal__caret" aria-hidden="true"></span>
    </li>
  </ol>
</div>

<style>
  .terminal {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal__bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .terminal__bar p {
    margin-left: auto;
    font-size: var(--fs-micro);
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .terminal__body {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .terminal__line {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
    transition-delay: calc(var(--i) * var(--step));
  }

  .terminal__line.is-prompt { color: var(--color-text); }
  .terminal__line.is-prompt .terminal__sigil { color: var(--color-accent-2); }
  .terminal__line.is-step .terminal__sigil { color: var(--color-accent-3); }
  .terminal__line.is-done .terminal__sigil { color: var(--color-success); }

  .terminal__caret {
    display: inline-block;
    width: 0.5rem;
    height: 1em;
    background: var(--color-accent-2);
    vertical-align: -0.15em;
    animation: caret-blink 1.1s steps(2, start) infinite;
  }

  [data-sequence].is-running .terminal__line {
    opacity: 1;
    transform: none;
  }

  @keyframes caret-blink {
    to { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__line { opacity: 1; transform: none; }
    .terminal__caret { animation: none; }
  }
</style>
